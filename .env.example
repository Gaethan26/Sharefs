# --- Obligatoire : Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # serveur uniquement, pour l'e-mail quotidien
NEXT_PUBLIC_APP_URL=https://le-cercle.vercel.app

# --- Connexion Google (activer aussi le provider dans Supabase) ---
NEXT_PUBLIC_GOOGLE_ENABLED=0       # 1 pour afficher le bouton

# --- Catalogue (facultatif, la saisie manuelle marche sans) ---
TMDB_API_KEY=                      # films et séries + "où regarder" en France (jeton "API Read Access Token")
RAWG_API_KEY=                      # jeux vidéo
GOOGLE_BOOKS_API_KEY=              # livres (fonctionne sans clé, avec quota réduit)

# --- Pitch sans spoiler par Claude (facultatif) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- E-mail quotidien (facultatif) ---
RESEND_API_KEY=
EMAIL_FROM=Le Cercle <cercle@ton-domaine.fr>
CRON_SECRET=                       # chaîne aléatoire, Vercel l'envoie au cron
